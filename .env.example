# Agentic Medical License - Complete Production Environment Configuration
# Copy this file to .env and configure your production keys.

# =====================================================================
# 1. DATABASE CONFIGURATION
# =====================================================================
DATABASE_URL=sqlite:///medical_ai.db

# =====================================================================
# 2. MACHINE LEARNING & EMBEDDING MODELS
# =====================================================================
ML_MODEL_PATH=models/triage_model.pkl
ML_ENCODER_PATH=models/encoders.pkl
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =====================================================================
# 3. MAP & GEOCODING PROVIDER
# =====================================================================
# Uses OpenStreetMap & Overpass API with dark tiles (No API key required by default)
MAP_PROVIDER=osm
# Optional: Mapbox / Carto key if using dedicated enterprise vector tiles
# MAP_API_KEY=your_map_api_key_here

# =====================================================================
# 4. REAL SMS DELIVERY PROVIDER (Choose ONE for Live Delivery)
# =====================================================================
# Provider selection: 'twilio' | 'msg91' | 'fast2sms'
SMS_PROVIDER=twilio

# Option A: Twilio (Global / US / India)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_registered_phone_here

# Option B: MSG91 (India DLT Registered)
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_SENDER_ID=MEDAST

# Option C: Fast2SMS (India Quick SMS)
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# =====================================================================
# 5. LLM CLINICAL EXPLAINABILITY & ASSISTANT (Optional)
# =====================================================================
# If omitted or placeholder, system runs in standalone offline ML mode (Random Forest + Embedder + FAISS)
GROQ_API_KEY=your_groq_api_key_here
