# Agentic Medical Analyser Environment Configuration
# Copy this file to .env and fill in the values.

# Required for AI Explainability and Agentic Assistant
GROQ_API_KEY=your_groq_api_key_here

# Optional: Database configuration (Defaults to local SQLite if not set)
# DATABASE_URL=sqlite:///medical_ai.db

# Optional: SMS Notifications Provider (Defaults to 'simulation' if not set)
# SMS_PROVIDER=simulation
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# MSG91 Alternative Configuration:
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=MEDAST
